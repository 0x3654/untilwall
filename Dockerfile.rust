# syntax=docker/dockerfile:1

# Until Wall - Rust backend image.
# Stage 1 exports the Next.js UI as static files (API routes are removed;
# the Rust server owns /goal and /api/*).
# Stage 2 runs the golden byte-parity tests and builds the server binary.
# Stage 3 is the slim runtime: binary + static UI + fonts only.

########## Stage 1: UI static export ##########
FROM node:20-alpine AS ui
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY src/package.json src/package-lock.json ./
RUN npm ci
COPY src/ ./
RUN rm -rf app/goal app/api middleware.ts __tests__
ARG APP_URL=http://localhost:3000
ENV EXPORT=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_APP_URL=${APP_URL}
RUN npm run build

########## Stage 2: Rust build + tests ##########
FROM rust:1.90-alpine AS build
RUN apk add --no-cache musl-dev
WORKDIR /src
ENV CARGO_TARGET_DIR=/target
COPY rust/Cargo.toml rust/Cargo.lock ./
COPY rust/src ./src
COPY rust/tests ./tests
# golden SVG references for the byte-parity test (png/html bodies excluded
# from the context via .dockerignore)
COPY tests/golden /tests/golden
RUN cargo test --release && cargo build --release --bin untilwall

########## Stage 3: runtime ##########
FROM alpine:3.22
RUN apk add --no-cache ttf-dejavu font-noto-emoji tini && \
    addgroup -S -g 1001 untilwall && \
    adduser -S -u 1001 -G untilwall untilwall

COPY --from=build --chown=untilwall:untilwall /target/release/untilwall /app/untilwall
COPY --from=ui --chown=untilwall:untilwall /app/out /app/static

RUN mkdir -p /app/data && chown -R untilwall:untilwall /app/data

USER 1001:1001

ENV PORT=3000 \
    DATA_DIR=/app/data \
    STATIC_DIR=/app/static

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:3000/api/health || exit 1

EXPOSE 3000

ARG GIT_REV=""
ARG SOURCE_URL="https://github.com/0x3654/untilwall"
LABEL org.opencontainers.image.title="Until Wall" \
      org.opencontainers.image.description="Life calendar wallpaper generator (Rust backend)" \
      org.opencontainers.image.version="2.0.0" \
      org.opencontainers.image.authors="0x3654" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.revision="${GIT_REV}"

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/app/untilwall"]
